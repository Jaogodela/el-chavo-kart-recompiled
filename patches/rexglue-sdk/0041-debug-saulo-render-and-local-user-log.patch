+static void LogLocalUserState(uint32_t user_index, uint32_t signin_state) {
+  static uint32_t last[4] = {0xFF, 0xFF, 0xFF, 0xFF};
+  if (user_index >= 4 || last[user_index] == signin_state) {
+    return;
+  }
+  last[user_index] = signin_state;
+  const bool controller = IsGuestUser(user_index) || (user_index == 0 && signin_state != 0);
+  std::string name;
+  REX_KERNEL_STATE()->user_profile()->display_name(user_index, &name);
+  if (name.empty() && signin_state != 0) {
+    name = GuestName(user_index);
+  }
+  REXLOG_INFO("[DEBUG_SAULO][LOCAL-USER] slot={} controller={} signin={} xuid_valid={} name={}", user_index,
+              controller ? "yes" : "no", signin_state == 0 ? "none" : "local", signin_state != 0 ? "yes" : "no",
+              name.empty() ? "-" : name);
+}
