+struct DebugSauloIdle {
+  uint64_t idle_us = 0;
+  std::chrono::steady_clock::time_point published = std::chrono::steady_clock::now();
+};
+
+DebugSauloIdle g_debug_saulo_idle;
+
+void DebugSauloAddIdle(std::chrono::steady_clock::time_point begin) {
+  const auto now = std::chrono::steady_clock::now();
+  g_debug_saulo_idle.idle_us += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(now - begin).count());
+  if (now - g_debug_saulo_idle.published >= std::chrono::seconds(1)) {
+    g_debug_saulo_idle.published = now;
+    rex::cvar::SetFlagByName("dbg_saulo_cp_idle_us", std::to_string(g_debug_saulo_idle.idle_us));
+    g_debug_saulo_idle.idle_us = 0;
+  }
+}
