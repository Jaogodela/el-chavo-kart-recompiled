+// DEBUG_SAULO: microseconds the command processor spends per phase, published once a second.
+REXCVAR_DEFINE_INT32(dbg_saulo_cp_draw_us, 0, "GPU", "DEBUG_SAULO: microseconds issuing draws in the last second");
+REXCVAR_DEFINE_INT32(dbg_saulo_cp_copy_us, 0, "GPU", "DEBUG_SAULO: microseconds issuing resolves in the last second");
+REXCVAR_DEFINE_INT32(dbg_saulo_cp_swap_us, 0, "GPU", "DEBUG_SAULO: microseconds issuing swaps in the last second");
+REXCVAR_DEFINE_INT32(dbg_saulo_cp_fence_us, 0, "GPU", "DEBUG_SAULO: microseconds waiting on GPU fences in the last second");
+
+namespace {
+
+struct DebugSauloTotals {
+  uint64_t draw_us = 0;
+  uint64_t copy_us = 0;
+  uint64_t swap_us = 0;
+  uint64_t fence_us = 0;
+  std::chrono::steady_clock::time_point published = std::chrono::steady_clock::now();
+};
+
+DebugSauloTotals g_debug_saulo;
+
+class DebugSauloTimer {
+ public:
+  explicit DebugSauloTimer(uint64_t& total) : total_(total), begin_(std::chrono::steady_clock::now()) {}
+  ~DebugSauloTimer() {
+    total_ += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - begin_)
+                           .count());
+  }
+
+ private:
+  uint64_t& total_;
+  std::chrono::steady_clock::time_point begin_;
+};
+
+void DebugSauloWaitForFence(HANDLE event) {
+  DebugSauloTimer timer(g_debug_saulo.fence_us);
+  WaitForSingleObject(event, INFINITE);
+}
+
+void DebugSauloPublish() {
+  const auto now = std::chrono::steady_clock::now();
+  if (now - g_debug_saulo.published < std::chrono::seconds(1)) {
+    return;
+  }
+  g_debug_saulo.published = now;
+  rex::cvar::SetFlagByName("dbg_saulo_cp_draw_us", std::to_string(g_debug_saulo.draw_us));
+  rex::cvar::SetFlagByName("dbg_saulo_cp_copy_us", std::to_string(g_debug_saulo.copy_us));
+  rex::cvar::SetFlagByName("dbg_saulo_cp_swap_us", std::to_string(g_debug_saulo.swap_us));
+  rex::cvar::SetFlagByName("dbg_saulo_cp_fence_us", std::to_string(g_debug_saulo.fence_us));
+  g_debug_saulo.draw_us = g_debug_saulo.copy_us = g_debug_saulo.swap_us = g_debug_saulo.fence_us = 0;
+}
+
+}  // namespace
