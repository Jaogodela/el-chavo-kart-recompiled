+// Guest users 1-3 exist while a pad is assigned to them, as offline local players.
+bool IsGuestUser(uint32_t user_index) {
+  if (user_index == 0 || user_index >= rex::input::kMaxGuestUsers) {
+    return false;
+  }
+  auto* input = static_cast<rex::input::InputSystem*>(REX_KERNEL_STATE()->emulator()->input_system());
+  return input && input->IsUserConnected(user_index);
+}
+
+uint64_t GuestXuid(uint32_t user_index) {
+  return REX_KERNEL_STATE()->user_profile()->xuid() + user_index;
+}
+
+std::string GuestName(uint32_t user_index) {
+  std::string name;
+  if (!REX_KERNEL_STATE()->user_profile()->display_name(user_index, &name)) {
+    name = "Player " + std::to_string(user_index + 1);
+  }
+  return name;
+}
