+bool InputSystem::IsUserConnected(uint32_t user_index) {
+  std::lock_guard lock(mutex_);
+  if (!assignment_) {
+    return false;
+  }
+
+  RefreshDevices();
+  std::vector<DeviceId> ids;
+  assignment_->DevicesForUser(user_index, ids);
+  return std::any_of(ids.begin(), ids.end(), [&](DeviceId id) {
+    const DeviceInfo* info = DeviceInfoFor(id);
+    return info && !info->synthetic;
+  });
+}
