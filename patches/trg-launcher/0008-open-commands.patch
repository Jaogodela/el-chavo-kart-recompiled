 void OpenInFileManager(const std::string& utf8_path);
+// Opens an http or https address in the default browser; any other text is ignored.
 void OpenUrl(const std::string& url);
 
+// What OpenUrl and OpenInFileManager ask the system to run. Windows hands
+// program and parameters to ShellExecute (program is the address itself for a
+// URL); elsewhere program and args are started directly, never through a shell,
+// so no text in a path or an address is read as a command.
+struct OpenCommand {
+  std::string program;
+  std::vector<std::string> args;
+  std::string parameters;
+};
+std::optional<OpenCommand> BuildOpenUrlCommand(const std::string& url);
+std::optional<OpenCommand> BuildOpenInFileManagerCommand(const std::string& utf8_path);
+void RunOpenCommand(const OpenCommand& command);
+
+// Replaces RunOpenCommand, so tests see the commands without running them.
+// Returns the previous hook; nullptr restores running them.
+using OpenCommandHook = void (*)(const OpenCommand&);
+OpenCommandHook SetOpenCommandHook(OpenCommandHook hook);
+
 // True while Shift is held: the "bring the launcher back" override.
 bool ShiftHeld();
 
