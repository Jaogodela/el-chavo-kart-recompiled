# rexglue codegen rewrites the manifest with LF endings on every run.
el_chavo_kart_manifest.toml text eol=lf

# The runtime patches are applied with git apply.
patches/rexglue-sdk/* text eol=lf

*.sh text eol=lf
*.png binary
*.ico binary

# Rows whose English text ends in a space are joined to other text at run time.
src/pt_br_ui_text.cpp whitespace=-blank-at-eol
